# Rust build artifacts
target/

# Python bytecode from the tools/ harnesses
__pycache__/

# Editor / OS cruft
.DS_Store

# Binary blobs are ignored by default: a stray .bin is either a dump of live
# pairing material or a build artifact. The cyw43 blobs are the deliberate
# exception -- prebuilt, required to build, and tracked.
*.bin
!firmware/cyw43-firmware/*.bin

# Live BLE bond keys (LTK/IRK) for every paired host, dumped by
# `just backup-storage`. .gitignore is no defence against `git add -f` -- keep
# an out-of-tree copy too.
pico-numpad-config-backup.bin
